# Copy to .env and fill in your keys:  cp .env.example .env

# ---- Required ----
OPENAI_API_KEY=sk-...              # or your Gemini / Groq key (see LLM section)
SARVAM_API_KEY=...                 # https://dashboard.sarvam.ai  (STT + Telugu/Hindi/English voices)

# Public HTTPS URL of this server (ngrok / Render / Railway). Needed for Twilio phone calls.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ---- Speech-to-text ----
STT_PROVIDER=sarvam                # sarvam (auto-detects en/hi/te) | deepgram
DEEPGRAM_API_KEY=                  # https://console.deepgram.com  (only if STT_PROVIDER=deepgram)
DEEPGRAM_LANGUAGE=multi            # multi | en | hi | te

# ---- LLM (any OpenAI-compatible API) ----
# OpenAI (default):     OPENAI_MODEL=gpt-4.1-mini   or the cheaper gpt-4.1-nano
# Google Gemini (cheap, free tier for testing):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-3.5-flash-lite
#   OPENAI_API_KEY=<Gemini API key from aistudio.google.com>
# Groq (free tier, very fast):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
# Less "thinking" = faster replies. Try: minimal | low (empty = model default). Ignored if unsupported.
LLM_REASONING_EFFORT=

# ---- Knowledge base (RAG over documents in knowledge/ and dashboard uploads) ----
# auto = gemini-embedding-001 on Gemini, text-embedding-3-small on OpenAI; off = keyword search only
EMBEDDING_MODEL=auto
RAG_TOP_K=3

# ---- Voice ----
TTS_MODE=stream                    # stream (lowest latency) | rest (fallback)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# ---- Twilio (phone calls + SMS confirmations) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
TWILIO_WHATSAPP_FROM=              # optional, e.g. whatsapp:+14155238886 (Twilio sandbox)
TWILIO_VALIDATE_SIGNATURE=true

# ---- Patient messages (confirmations, changes, reminders, staff messages) ----
# WhatsApp via Meta's WhatsApp Cloud API (preferred in India; used instead of Twilio WhatsApp when set)
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_TEMPLATE=                  # approved utility template with one {{1}} body variable; needed outside the 24-hour window
META_WA_TEMPLATE_LANG=en
# Email via any SMTP server (Gmail: smtp.gmail.com + an App Password, or Zoho/SES/Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                         # e.g. "Sunrise Clinic <appointments@yourclinic.in>"
SMTP_STARTTLS=true

# ---- Platform admin login (all clinics) + login cookie signing ----
# Clinic staff get their own logins (Setup -> Staff). This account creates clinics on /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me           # in production: 12+ characters (the server refuses to start with this default)
SIGNUP_ENABLED=true                # clinics can create their own account on /signup
SIGNUP_CODE=                       # optional invitation code required on /signup
SECRET_KEY=                        # 32+ random characters (required in production): python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_ENV=development                # production = refuse unsafe settings, hide /docs and error details (automatic on Render)

# ---- Public web chat abuse limits (each conversation costs AI credits) ----
CHAT_SESSIONS_PER_HOUR=20          # new conversations per visitor address
CHAT_CONCURRENT_PER_IP=2
CHAT_MAX_MESSAGES=60               # typed messages per conversation
CHAT_MAX_CHARS=500                 # per typed message

# ---- Exotel (Indian phone numbers), see docs/GO_LIVE.md Step 4 ----
EXOTEL_STREAM_SECRET=              # password in the Voicebot applet URL

# ---- Public demo protection ----
DEMO_ACCESS_CODE=                  # set a code before sharing the demo link publicly
MAX_CONCURRENT_CALLS=5

# ---- Database (SQLite by default) ----
# DATABASE_URL=postgresql+asyncpg://vaani:vaani@localhost:5432/vaanidesk

# ---- Google Calendar sync (optional) ----
# Bookings appear in this calendar; its existing events block those slots.
# Local:  path to the downloaded service-account key file
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# Cloud (Render/Railway): paste the whole JSON key on one line instead
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
